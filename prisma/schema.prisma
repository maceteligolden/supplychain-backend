generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform user stored in PostgreSQL for auth and audit trails.
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole       @default(SUPER_ADMIN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

enum UserRole {
  SUPER_ADMIN
}

enum CommodityUnit {
  KG
  TON
  LITRE
  BAG
  UNIT
}

/// Hashed refresh token persisted for rotation and revocation.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Master commodity record used across farms, batches, and supply chains.
model Commodity {
  id        String        @id @default(cuid())
  name      String
  code      String        @unique
  imageUrl  String        @default("")
  unit      CommodityUnit
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([name])
}

enum ActorType {
  COLLECTION_CENTRE
  PROCESSOR
  WAREHOUSE
  EXPORTER
  CARRIER
}

enum ActorStatus {
  ACTIVE
  INACTIVE
}

/// Supply chain participant (collection centre, processor, exporter, etc.).
model Actor {
  id             String      @id @default(cuid())
  name           String
  code           String      @unique
  type           ActorType
  addressLine1   String?
  addressCity    String
  addressRegion  String
  addressCountry String
  status         ActorStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([name])
  @@index([status])
}
