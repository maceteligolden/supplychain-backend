generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform user stored in PostgreSQL for auth and audit trails.
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole       @default(SUPER_ADMIN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

enum UserRole {
  SUPER_ADMIN
}

enum CommodityUnit {
  KG
  TON
  LITRE
  BAG
  UNIT
}

/// Hashed refresh token persisted for rotation and revocation.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Master commodity record used across farms, batches, and supply chains.
model Commodity {
  id            String          @id @default(cuid())
  name          String
  code          String          @unique
  imageUrl      String          @default("")
  unit          CommodityUnit
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  farmLinks     FarmCommodity[]
  batches       Batch[]
  supplyChains  SupplyChain[]

  @@index([name])
}

enum ActorType {
  COLLECTION_CENTRE
  PROCESSOR
  WAREHOUSE
  EXPORTER
  CARRIER
}

enum ActorStatus {
  ACTIVE
  INACTIVE
}

/// Supply chain participant (collection centre, processor, exporter, etc.).
model Actor {
  id             String      @id @default(cuid())
  name           String
  code           String      @unique
  type           ActorType
  addressLine1   String?
  addressCity    String
  addressRegion  String
  addressCountry String
  status         ActorStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  supplyChainEvents SupplyChainEvent[]

  @@index([name])
  @@index([status])
}

enum FarmStatus {
  DRAFT
  MAPPED
  READY_FOR_ASSESSMENT
  UNDER_REVIEW
  ASSESSED
  APPROVED
  REJECTED
}

/// Farm registered for traceability and deforestation assessment.
model Farm {
  id                         String          @id @default(cuid())
  name                       String
  code                       String          @unique
  status                     FarmStatus      @default(DRAFT)
  ownerFirstName             String          @default("")
  ownerLastName              String          @default("")
  ownerPhone                 String          @default("")
  ownerEmail                 String          @default("")
  country                    String          @default("")
  region                     String          @default("")
  city                       String          @default("")
  latitude                   Float?
  longitude                  Float?
  annualProductionEstimateKg Float?
  areaHectares               Float?
  declarationAccepted        Boolean         @default(false)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  commodities                FarmCommodity[]
  batches                    Batch[]
  boundary                   FarmBoundary?
  assessments                FarmAssessment[]
  landCoverPoints            FarmLandCoverPoint[]

  @@index([name])
}

/// GeoJSON-style polygon boundary for deforestation assessment.
model FarmBoundary {
  id            String   @id @default(cuid())
  farmId        String   @unique
  coordinates   Json
  areaHectares  Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

enum AssessmentRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum FarmAssessmentStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

enum FarmAssessmentSource {
  GFW_WDPA
  WHISP_GFW_WDPA
  FALLBACK
}

/// Deforestation assessment run for a farm boundary.
model FarmAssessment {
  id                    String               @id @default(cuid())
  farmId                String
  riskLevel             AssessmentRiskLevel?
  analysis              Json?
  assessedAt            DateTime?
  boundaryAreaHectares  Float?
  status                FarmAssessmentStatus @default(PENDING)
  errorMessage          String?
  source                FarmAssessmentSource @default(GFW_WDPA)
  providerMetadata      Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  farm                  Farm                 @relation(fields: [farmId], references: [id], onDelete: Cascade)
  landCoverPoints       FarmLandCoverPoint[]

  @@index([farmId])
  @@index([status])
  @@index([assessedAt])
}

enum FarmLandCoverSource {
  BASELINE
  ASSESSMENT
}

/// Land-cover observation point for timeline charts.
model FarmLandCoverPoint {
  id                    String              @id @default(cuid())
  farmId                String
  observedAt            DateTime
  forestCoverPercent    Float
  deforestationPercent  Float
  source                FarmLandCoverSource
  assessmentId          String?
  createdAt             DateTime            @default(now())
  farm                  Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  assessment            FarmAssessment?     @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([farmId])
  @@index([observedAt])
}

/// Many-to-many link between farms and commodities they grow.
model FarmCommodity {
  farmId      String
  commodityId String
  farm        Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  commodity   Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)

  @@id([farmId, commodityId])
}

enum SupplyChainStatus {
  ACTIVE
  INACTIVE
}

/// Supply chain journey used for batch allocation (full CRUD module deferred).
model SupplyChain {
  id          String            @id @default(cuid())
  name        String
  code        String            @unique
  description String?
  status      SupplyChainStatus @default(ACTIVE)
  commodityId String?
  commodity   Commodity?        @relation(fields: [commodityId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  allocations BatchAllocation[]
  events      SupplyChainEvent[]

  @@index([status])
}

enum SupplyChainEventType {
  HARVEST
  COLLECTION
  PROCESSING
  WAREHOUSING
  EXPORT
  IN_TRANSIT
  DELIVERED
}

/// Lifecycle event recorded on a supply chain journey.
model SupplyChainEvent {
  id            String               @id @default(cuid())
  supplyChainId String
  type          SupplyChainEventType
  occurredAt    DateTime
  actorId       String
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  supplyChain   SupplyChain          @relation(fields: [supplyChainId], references: [id], onDelete: Cascade)
  actor         Actor                @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([supplyChainId, type])
  @@index([supplyChainId])
  @@index([occurredAt])
  @@index([actorId])
}

enum BatchStatus {
  CREATED
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
}

/// Harvest batch recorded against a farm and commodity.
model Batch {
  id           String            @id @default(cuid())
  batchNumber  String            @unique
  farmId       String
  commodityId  String
  harvestDate  String
  quantity     Float
  unit         CommodityUnit
  status       BatchStatus       @default(CREATED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  farm         Farm              @relation(fields: [farmId], references: [id], onDelete: Restrict)
  commodity    Commodity         @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  allocations  BatchAllocation[]

  @@index([farmId])
}

/// Quantity of a batch allocated to a supply chain.
model BatchAllocation {
  id            String      @id @default(cuid())
  batchId       String
  supplyChainId String
  quantity      Float
  allocatedAt   DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  batch         Batch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  supplyChain   SupplyChain @relation(fields: [supplyChainId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([supplyChainId])
}

/// Atomic per-entity yearly sequence for inventory codes (PREFIX-YYYY-NNNN).
model CodeSequence {
  id        String   @id @default(cuid())
  prefix    String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([prefix, year])
}
