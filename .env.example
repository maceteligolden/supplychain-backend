NODE_ENV=development
PORT=5009
LOG_LEVEL=info
API_VERSION=v1

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000

# MongoDB (operational / document data)
MONGODB_URI=mongodb://localhost:27017/supplychain

# PostgreSQL via Prisma (relational / transactional data)
DATABASE_URL=postgresql://supplychain:supplychain@localhost:5432/supplychain?schema=public

# JWT (auth module — update before production)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
