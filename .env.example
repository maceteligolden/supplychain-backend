NODE_ENV=development
PORT=5009
LOG_LEVEL=info
API_VERSION=v1

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000

# PostgreSQL via Prisma
DATABASE_URL=postgresql://supplychain:supplychain@localhost:5432/supplychain?schema=public

# Local directory for uploaded commodity images
UPLOAD_DIR=uploads

# JWT access token
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# JWT refresh token signing (opaque tokens stored hashed in DB)
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Default superadmin seeded on `yarn seed`
SUPER_ADMIN_EMAIL=john@example.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_FIRST_NAME=John
SUPER_ADMIN_LAST_NAME=Doe

# Deforestation assessment providers (omit for deterministic FALLBACK in local/CI)
GFW_API_KEY=
WHISP_API_KEY=
WDPA_API_TOKEN=

# Nominatim User-Agent (required by OSM usage policy)
NOMINATIM_USER_AGENT=SupplyChainTraceabilityPOC/1.0

# Assessment async worker — enable in POC so 202 responses complete
ASSESSMENT_WORKER_ENABLED=true
ASSESSMENT_WORKER_POLL_MS=5000
ASSESSMENT_SYNC_TIMEOUT_MS=15000
