NODE_ENV=development
PORT=5009
LOG_LEVEL=info
API_VERSION=v1

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000

# PostgreSQL via Prisma
DATABASE_URL=postgresql://supplychain:supplychain@localhost:5432/supplychain?schema=public

# Local directory for uploaded commodity images
UPLOAD_DIR=uploads

# JWT access token
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# JWT refresh token signing (opaque tokens stored hashed in DB)
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Default superadmin seeded on `yarn seed`
SUPER_ADMIN_EMAIL=john@example.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_FIRST_NAME=John
SUPER_ADMIN_LAST_NAME=Doe
